-- =========================================================
-- DRAGGING
-- =========================================================
local dragging = false
local dragStart
local startPosition

local function updateDrag(input)
    local delta = input.Position - dragStart
    card.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
    shadow.Position = UDim2.new(
        card.Position.X.Scale,
        card.Position.X.Offset,
        card.Position.Y.Scale,
        card.Position.Y.Offset + 8
    )
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = card.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

-- =========================================================
-- BUTTONS
-- =========================================================
launch.MouseEnter:Connect(function()
    tween(launch, 0.15, {BackgroundColor3 = Color3.fromRGB(35, 170, 255)})
    tween(launchStroke, 0.15, {Transparency = 0})
end)
launch.MouseLeave:Connect(function()
    tween(launch, 0.15, {BackgroundColor3 = Color3.fromRGB(0, 145, 240)})
    tween(launchStroke, 0.15, {Transparency = 0.4})
end)

discord.MouseEnter:Connect(function()
    tween(discord, 0.15, {BackgroundColor3 = Color3.fromRGB(108, 121, 255)})
end)
discord.MouseLeave:Connect(function()
    tween(discord, 0.15, {BackgroundColor3 = Color3.fromRGB(88, 101, 242)})
end)

close.MouseEnter:Connect(function()
    tween(close, 0.15, {TextColor3 = Color3.fromRGB(245, 75, 75), Rotation = 90})
end)
close.MouseLeave:Connect(function()
    tween(close, 0.15, {TextColor3 = Color3.fromRGB(120, 126, 145), Rotation = 0})
end)

local function closeGui()
    tween(card, 0.3, {
        Position = UDim2.new(0.5, 0, 0.5, 18),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(shadow, 0.3, {BackgroundTransparency = 1})
    tween(cardStroke, 0.2, {Transparency = 1})
    for _, obj in ipairs({title, subtitle, status, launchLabel, discord, info, close, logo}) do
        if obj:IsA("ImageLabel") then
            tween(obj, 0.18, {ImageTransparency = 1})
        else
            tween(obj, 0.18, {TextTransparency = 1})
        end
    end
    task.delay(0.35, function()
        if Gui then Gui:Destroy() end
    end)
end

close.MouseButton1Click:Connect(closeGui)

launch.MouseButton1Click:Connect(function()
    local url = trim(CONFIG.SCRIPT_URL)
    local source = CONFIG.SCRIPT_SOURCE or ""
    local sourceCheck = trim(source)

    status.TextColor3 = Color3.fromRGB(0, 155, 255)

    if sourceCheck == "" or sourceCheck == "-- YOUR SCRIPT GOES HERE" then
        if url == "" then
            status.TextColor3 = Color3.fromRGB(245, 75, 75)
            status.Text = "Not configured — add your own SCRIPT_URL or SCRIPT_SOURCE."
            notify("Launch blocked: no own-script payload configured.", true)
            return
        end

        status.Text = "Loading your script..."

        local ok, err = pcall(function()
            local body = game:HttpGet(url)
            local fn = loadstring(body)
            if not fn then
                error("loadstring returned nil")
            end
            fn()
        end)

        if ok then
            status.TextColor3 = Color3.fromRGB(70, 205, 130)
            status.Text = "Script launched successfully."
            task.delay(0.5, closeGui)
        else
            status.TextColor3 = Color3.fromRGB(245, 75, 75)
            status.Text = "Launch failed — check the URL/payload."
            notify("Launch failed: " .. tostring(err), true)
        end
        return
    end

    status.Text = "Launching embedded script..."

    local ok, err = pcall(function()
        local fn = loadstring(source)
        if not fn then
            error("loadstring returned nil")
        end
        fn()
    end)

    if ok then
        status.TextColor3 = Color3.fromRGB(70, 205, 130)
        status.Text = "Script launched successfully."
        task.delay(0.5, closeGui)
    else
        status.TextColor3 = Color3.fromRGB(245, 75, 75)
        status.Text = "Embedded script failed to run."
        notify("Embedded script failed: " .. tostring(err), true)
    end
end)

discord.MouseButton1Click:Connect(function()
    local invite = "https://discord.gg/" .. CONFIG.DISCORD_INVITE
    if setclipboard then
        pcall(setclipboard, invite)
    end
    status.TextColor3 = Color3.fromRGB(88, 101, 242)
    status.Text = "Discord invite copied."
end)

-- =========================================================
-- INTRO
-- =========================================================
task.spawn(function()
    task.wait(0.1)
    tween(card, 0.55, {Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 0}, Enum.EasingStyle.Back)
    tween(shadow, 0.55, {BackgroundTransparency = 0.55}, Enum.EasingStyle.Back)
    tween(cardStroke, 0.5, {Transparency = 0})
    task.wait(0.12)
    tween(logo, 0.35, {ImageTransparency = 0})
    tween(title, 0.35, {TextTransparency = 0})
    tween(subtitle, 0.35, {TextTransparency = 0})
    tween(divider, 0.3, {BackgroundTransparency = 0})
    task.wait(0.12)
    tween(status, 0.3, {TextTransparency = 0})
    tween(launch, 0.3, {BackgroundTransparency = 0})
    tween(launchLabel, 0.3, {TextTransparency = 0})
    tween(discord, 0.3, {BackgroundTransparency = 0, TextTransparency = 0})
    tween(info, 0.3, {TextTransparency = 0})
    tween(close, 0.3, {TextTransparency = 0})
end)
