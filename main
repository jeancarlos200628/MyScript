    -- Example: https://raw.githubusercontent.com/you/repo/main/script.lua
    SCRIPT_URL = "",

    -- Or paste YOUR OWN script between [[ and ]].
    -- Leave this placeholder alone when using SCRIPT_URL.
    SCRIPT_SOURCE = [[
-- YOUR SCRIPT GOES HERE
